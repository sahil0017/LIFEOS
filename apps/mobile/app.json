{
  "expo": {
    "name": "LIFEOS",
    "slug": "lifeos",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.sahkanun.lifeos",
      "supportsTablet": true,
      "infoPlist": {
        "NSMotionUsageDescription": "LIFEOS reads step totals only when you request an activity refresh.",
        "NSMicrophoneUsageDescription": "LIFEOS records voice notes only when you tap record."
      }
    },
    "android": {
      "package": "com.sahkanun.lifeos",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "LIFEOS uses the camera only when you choose to capture an image for analysis.",
          "recordAudioAndroid": false
        }
      ],
      "expo-secure-store",
      [
        "expo-audio",
        {
          "microphonePermission": "Allow LIFEOS to use the microphone to record voice notes when you tap record."
        }
      ],
      "expo-asset",
      "expo-font"
    ],
    "extra": {
      "workersAiUrl": "https://lifeos-cloudflare-ai.lifeos-cloudflare-ai.workers.dev",
      "eas": {
        "projectId": "3e3f3838-66a7-4868-9cff-0c766894717d"
      }
    },
    "owner": "sahkanun",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/3e3f3838-66a7-4868-9cff-0c766894717d"
    }
  }
}
